{
  "name": "lymon-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:cov:scope": "ng test --watch=false --coverage --coverage-reporters lcov --coverage-reporters text --coverage-reporters text-summary --include \"src/app/domain/**/use-cases/**/*.spec.ts\" --include \"src/app/presentation/tenant/features/settings/pages/tenant-profile/tenant-profile.spec.ts\" --include \"src/app/presentation/tenant/features/incidents/**/*.spec.ts\" --include \"src/app/infrastructure/tenant/tenant/tenant.repository.impl.spec.ts\" --include \"src/app/infrastructure/tenant/incident-report/incident-report.repository.impl.spec.ts\" --coverage-include \"src/app/domain/**/*.ts\" --coverage-include \"src/app/infrastructure/**/*.ts\" --coverage-include \"src/app/presentation/tenant/features/settings/pages/tenant-profile/tenant-profile.ts\" --coverage-include \"src/app/presentation/tenant/features/incidents/pages/create-incident-report/create-incident-report.ts\" --coverage-include \"src/app/presentation/tenant/features/incidents/pages/edit-incident-report/edit-incident-report.ts\" --coverage-include \"src/app/presentation/tenant/features/incidents/pages/incident-report-list/incident-report-list.ts\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@ng-icons/bootstrap-icons": "^33.1.0",
    "@ng-icons/core": "^33.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.59.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.6.0",
    "cypress": "^15.15.0",
    "dotenv": "^17.4.2",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
