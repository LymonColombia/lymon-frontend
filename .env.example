# E2E Test credentials — copy to .env and fill in real values.
# These values are used by auth.setup.ts and individual spec files.

MANAGER_EMAIL=test
MANAGER_PASSWORD=test

# URLs used by the Playwright suite.
# BASE_URL is the Angular app; BACKEND_URL is the NestJS API.
BASE_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000
