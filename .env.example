# ─── Proveedor de IA (ollama | gemini | openai | openrouter) ───
# Recomendado: gemini (gratis con Google AI Studio)
PROVIDER=gemini

# ─── Google Gemini — GRATIS con API Key de Google AI Studio ───
# 1. Ve a https://aistudio.google.com/app/apikey
# 2. Crea una API Key (empieza con AIzaSy...)
# 3. Nivel gratuito: 15 peticiones/minuto, 1M tokens/minuto
GEMINI_API_KEY=AIzaSyTU_CLAVE_AQUI
GEMINI_MODEL=google/gemini-2.5-flash

# ─── Ollama local (sin costo, requiere Ollama corriendo) ───
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.1

# ─── OpenRouter — Modelos gratuitos en la nube ───
# NOTA: Stagehand v3 NO soporta OpenRouter directamente.
# Usa Gemini o Ollama en su lugar.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ─── OpenAI (requiere API Key de pago) ───
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini

# ─── App under test ───
APP_URL=http://localhost:4200
LOGIN_EMAIL=tu-email@ejemplo.com
LOGIN_PASSWORD=tu-password

# ─── Navegador ───
HEADLESS=false
